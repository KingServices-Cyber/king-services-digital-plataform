# Supabase — King Services Digital Platform
# Projeto dedicado: "king-services-digital-platform" (ref: nupbetbitchsnwtccuew)
#
# Copie este arquivo para .env.local e preencha os valores.
# Estas variáveis têm o prefixo NEXT_PUBLIC_ porque são usadas no navegador.
# A chave "publishable"/anon é segura para exposição pública — a proteção dos
# dados é feita pelas políticas de Row Level Security (RLS) no banco.

NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-chave-publishable-ou-anon

# URL canônica do site (usada em SEO: metadata, sitemap, robots, Open Graph e JSON-LD).
# Em produção, use o domínio real. Em previews, pode apontar para a URL do deploy.
NEXT_PUBLIC_SITE_URL=https://www.kingservices.com.br
